#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

// hold-preferred commits to the hold the moment another key goes down, which
// mixes stray modifiers into fast typing. balanced waits for that key to be
// released as well, which is what separates a deliberate modifier press from
// a rolled one.
&mt {
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <13 14>;
            layers = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp Q      &kp W     &kp E     &kp R       &kp T                                                          &kp Y      &kp U     &kp I      &kp O     &kp P
&kp A      &kp S     &kp D     &kp F       &kp G                                                          &kp H      &kp J     &kp K      &kp L     &kp SEMI
&kp Z      &kp X     &kp C     &kp V       &kp B        &kp SPACE                  &lt 1 RET              &kp N      &kp M     &kp COMMA  &kp DOT   &mt RIGHT_SHIFT FSLH
&kp LCTRL  &kp LGUI  &kp LALT  &lt 2 BSPC  &lt 3 SPACE  &mt LEFT_SHIFT LANGUAGE_1  &mt RSHIFT LANGUAGE_2  &kp ENTER  &kp BSPC  &kp RALT   &kp RGUI  &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                  &kp LS(N6)      &kp LS(N7)     &kp LS(N8)        &kp LS(N9)         &kp LS(N0)
&kp N1            &kp N2            &kp N3      &kp N4      &kp N5                      &kp LEFT_BRACE  &kp MINUS      &kp EQUAL         &kp RIGHT_BRACE    &kp COLON
&kp N6            &kp N7            &kp N8      &kp N9      &kp N0      &trans  &trans  &kp LS(MINUS)   &kp LS(EQUAL)  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
&trans            &trans            &trans      &trans      &trans      &trans  &trans  &kp TAB         &kp DEL        &trans            &trans             &trans
            >;
        };

        layer_2 {
            bindings = <
&kp F1   &kp F2   &kp F3        &kp F4        &kp F5                      &trans  &trans  &trans  &trans  &trans
&kp F6   &kp F7   &kp F8        &kp F9        &kp F10                     &trans  &trans  &trans  &trans  &trans
&kp F11  &kp F12  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans   &trans   &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans     &trans     &trans      &trans                   &kp HOME          &kp PG_UP  &kp PAGE_DOWN  &kp END    &kp ESCAPE
&trans  &trans     &trans     &trans      &trans                   &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT  &kp TAB
&trans  &trans     &trans     &trans      &trans   &trans  &trans  &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE  &kp PIPE
&trans  &mkp RCLK  &mkp LCLK  &kp DELETE  &kp TAB  &trans  &trans  &trans            &mkp LCLK  &mkp RCLK      &trans     &trans
            >;
        };

        // Spare layer, left blank to be filled in from ZMK Studio. &none
        // rather than &trans, so an unassigned key stays dead instead of
        // falling through to the layer below.
        // Nothing activates it yet, so it needs a &lt/&mo binding to reach.
        layer_4 {
            bindings = <
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none  &none  &none  &none  &none                &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
